---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../config/site";
import { getDictionary } from "../i18n";

interface Props {
  robots?: string;
}

const { robots = "index, follow" } = Astro.props;
const { ui } = getDictionary();
---

<!doctype html>
<html lang={site.defaultLocale} data-exit-url={site.quickExitUrl}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#FFF6EE" />
    <title>{site.documentTitle}</title>
    <meta name="description" content={site.documentTitle} />
    <meta name="robots" content={robots} />
    <meta property="og:title" content={site.documentTitle} />
    <meta property="og:description" content={site.documentTitle} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={site.documentTitle} />
    <meta name="twitter:description" content={site.documentTitle} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/nunito-mk.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#sodrzina">{ui.skip}</a>
    <Header pathname={Astro.url.pathname} />
    <main id="sodrzina">
      <slot />
    </main>
    <Footer pathname={Astro.url.pathname} />
    <script is:inline src="/safety.js"></script>
  </body>
</html>
