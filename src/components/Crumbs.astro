---
interface Crumb {
  href?: string;
  label: string;
}

interface Props {
  label: string;
  items: Crumb[];
}

const { label, items } = Astro.props;
---

<nav class="crumbs" aria-label={label}>
  <ol>
    {
      items.map((item, index) => (
        <li>
          {index > 0 && <span aria-hidden="true">/</span>}
          {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
        </li>
      ))
    }
  </ol>
</nav>
