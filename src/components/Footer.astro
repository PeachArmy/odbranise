---
import { site, paths } from "../config/site";
import { getDictionary } from "../i18n";
import { isCurrent } from "../lib/path";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const { ui } = getDictionary();
---

<footer class="site-footer">
  <div class="wrap">
    <nav class="footer-nav" aria-label={ui.footerLabel}>
      {
        ui.footerNav.map((item) => (
          <a href={item.href} aria-current={isCurrent(pathname, item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <p class="disclaimer">{ui.disclaimer}</p>
    <p class="fine">
      {ui.numbersChecked} {site.verifiedOnLabel}. <a href={paths.tracks}>{ui.cover}</a>.
    </p>
    <p class="fine">{ui.exitExplain}</p>
  </div>
</footer>
